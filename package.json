{
  "name": "mcp-weather-typescript",
  "version": "1.0.0",
  "description": "MCP server and CLI tools to fetch weather information in TypeScript",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-weather-server": "./dist/index.js",
    "weather-now": "./dist/weather-now.js",
    "weather-7days": "./dist/weather-7days.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "weather:now": "tsx src/weather-now.ts",
    "weather:7days": "tsx src/weather-7days.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "weather",
    "model-context-protocol",
    "open-meteo",
    "canberra"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
